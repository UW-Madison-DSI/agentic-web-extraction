# Every knob the library reads, grouped by concern. Lines that are *active* below
# are the ones worth setting per-environment; everything else is commented out at
# its real default — uncomment to override. Settings are also settable in Python
# (`Extractor(settings=Settings(...))`); a few are CLI flags too (see README).
#
# ─────────────────────────────────────────────────────────────────────────────
# Provider credentials (OPENAI_*, read un-prefixed so a standard OpenAI env works)
# ─────────────────────────────────────────────────────────────────────────────
# Any OpenAI-compatible endpoint. Defaults below target the UW-Madison DSI Spark
# gateway; swap for OpenAI (https://api.openai.com/v1/) or another endpoint.
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://spark.dsi.wisc.edu
# OPENAI_BASE_URL is optional — omit to use OpenAI's default (https://api.openai.com/v1/).

# Provider backend. Resolved by providers.get_provider; "openai" is the only v0
# impl (it also drives any OpenAI-compatible endpoint, per OPENAI_BASE_URL above).
# AWE_PROVIDER=openai

# ─────────────────────────────────────────────────────────────────────────────
# Models
# ─────────────────────────────────────────────────────────────────────────────
# Point these at models your key can actually access. Query the endpoint with:
#   curl $OPENAI_BASE_URL/v1/models -H "Authorization: Bearer $OPENAI_API_KEY"
# Extraction is the stronger/costlier call (fills the caller's schema); screen +
# link-scoring + summarization are cheap and share one (smaller) model.
AWE_MODEL_EXTRACT=gemma-4-26b-a4b-it   # default: gpt-5.5
AWE_MODEL_SCREEN=gemma-4-26b-a4b-it    # default: gpt-5.4-mini

# ─────────────────────────────────────────────────────────────────────────────
# Cost / service tier
# ─────────────────────────────────────────────────────────────────────────────
# Send every LLM call on OpenAI's "flex" service tier: Batch-API rates (50% off
# input and output, stacking with prompt caching) on *synchronous* calls, so the
# traversal is unchanged. You trade latency (the client's read timeout is raised
# 600s → 1800s) and capacity: flex can refuse a call with an uncharged
# 429 resource_unavailable, and that one call is retried on the standard tier.
# A knob for bulk/offline runs, not interactive ones. Never part of a cache key —
# the tier changes price and latency, not response content.
#
# OpenAI-specific: a non-OpenAI endpoint (including the Spark gateway above, or a
# local vLLM/llama.cpp server) will most likely ignore the field — leave this off
# unless OPENAI_BASE_URL points at OpenAI proper.
# AWE_USE_FLEX=false

# ─────────────────────────────────────────────────────────────────────────────
# Traversal
# ─────────────────────────────────────────────────────────────────────────────
# Fetch budget PER SEED: max readable pages the crawl spends LLM calls on for each
# seed URL (N seeds ⇒ N × this, in one shared frontier). The primary (and,
# deliberately, near-only) traversal knob. Errored/skipped fetches don't count.
AWE_MAX_FETCHES=10

# Wave concurrency / beam width: how many top-scored frontier links are popped and
# fetched/screened/scored at once. A *concurrency* knob, not a relevance policy —
# best-first ordering holds within each wave. 1 = strictly sequential best-first.
# AWE_MAX_WORKERS=8

# Treat every seed URL as content to extract from directly: skip the pre-screen
# (each seed is a guaranteed match) and link-scoring (nothing is queued), so the
# crawl fetches exactly the seeds, consolidates, extracts once, and stops. Use it
# when you already know each seed is a target page.
# AWE_SEED_IS_CONTENT=false

# Soft same-domain preference, expressed *to the LLM* rather than as a math weight:
# the screen and link-scorer calls are told the seed/page URL and a Python-computed
# on-domain signal, and asked to disfavor off-domain content. A nudge, not a filter
# — nothing is excluded, and a clearly on-target off-domain page still matches.
# AWE_PREFER_SEED_DOMAIN=false

# Fetch and read linked PDFs as page content. When false, a PDF response is treated
# as skipped: no LLM work, no budget cost.
# AWE_FOLLOW_PDF=true

# ─────────────────────────────────────────────────────────────────────────────
# Crawl citizenship (who we say we are, and where we agree not to go)
# ─────────────────────────────────────────────────────────────────────────────
# User-Agent sent on every fetch (origin and recovery), and the agent name the
# robots.txt check is evaluated against. The default names the *library*, not you,
# so a site operator with a complaint has nobody to write to but whoever owns the
# IP. Set it to something attributable, with a real contact URL.
# AWE_USER_AGENT=my-pipeline/1.0 (+https://example.edu/crawler; Some Team)

# Honor each origin's robots.txt for that user agent. Checked BEFORE the fetch, so a
# disallowed URL costs no request, no budget slot and no LLM call. Off by default
# (v0.2 behaviour); turn it on for any crawl of sites you don't own. A robots.txt
# that can't be obtained — 404, 401/403, 5xx, timeout — fails OPEN and says so in
# the log; see robots.py for why that is deliberate.
# AWE_RESPECT_ROBOTS=false

# Registrable domains exempt from the robots.txt check, comma-separated. For hosts
# whose robots.txt blanket-disallows automated clients but whose content you are
# authorized to read anyway (your own sites, a portal you have an agreement with).
# AWE_ROBOTS_OVERRIDES=

# NOTE the hard crawl boundary — the list of domains a scored link may be QUEUED
# from — is deliberately NOT an env var: it depends on the seeds of a given crawl,
# not on the environment. Pass it per crawl: Extractor(allowed_domains=[...]) or
# `awe extract --allowed-domain ...` (repeatable). Unset means unrestricted: any
# link the LLM scores highly may be fetched, wherever it points.

# ─────────────────────────────────────────────────────────────────────────────
# Blocked-page recovery
# ─────────────────────────────────────────────────────────────────────────────
# A non-2xx response is never treated as content, however it is Content-Typed —
# edge CDNs serve "Access Denied" and themed 404s as text/html, and without the
# guard that body gets screened, summarized and extracted as if it were the page.
# These routes are then tried, in the order listed, to recover the page anyway;
# whatever comes back is returned under the ORIGINAL url, so paths and citations
# stay canonical, and the route is recorded in ExtractionResult.fallbacks_used.
#
#   jina     — r.jina.ai renders the URL live and also reads PDFs
#   wayback  — the Internet Archive's newest capture (not live; see below)
#
# Set EMPTY to disable recovery and keep only the guard. NOTE both routes send
# the URL being crawled to a third party.
# AWE_FETCH_FALLBACKS=jina,wayback

# Optional Jina credential (un-prefixed, like OPENAI_*). Anonymous requests work
# but are rate-limited per IP, which a wave of blocked pages can trip.
# JINA_API_KEY=jina_...

# What Jina should return, sent as its X-Return-Format header. "html" gives the
# full DOM, so normalization, link extraction and the frontier behave exactly as
# on a direct fetch. Empty selects Jina's readability pass instead: markdown with
# the nav chrome stripped — far fewer tokens, but only the links it kept, so the
# crawl has less to expand into.
# AWE_JINA_RETURN_FORMAT=html

# Refuse Internet Archive captures older than N days; 0 accepts any age. Raise it
# when the criterion is time-sensitive and a years-old capture would be worse than
# no page at all.
# AWE_WAYBACK_MAX_AGE_DAYS=0

# ─────────────────────────────────────────────────────────────────────────────
# Content & context
# ─────────────────────────────────────────────────────────────────────────────
# Convert fetched HTML to Markdown before the LLM sees it (cuts tokens sharply).
# PDFs are converted regardless.
# AWE_NORMALIZE=true

# Input-token budget for the single consolidated extraction. Every screened-in
# page's markdown is concatenated; if that exceeds this, it is summarized down by a
# criteria-aware map-reduce on the screen model (never silently truncated), which
# also uses this value as its per-chunk target. Lower it for smaller context
# windows — the default sits under a large one (e.g. gpt-5.5) with room for the
# schema, instructions, and output.
# AWE_MAX_CONTEXT_TOKENS=128000

# Summarize the concatenated pages on every run, not only when they exceed
# AWE_MAX_CONTEXT_TOKENS. Off by default, since summarization is the pipeline's only
# lossy step (the extract model never sees the original text). Turn it on to want the
# compression for its own sake: boilerplate and off-criterion prose reduced to a
# criteria/schema-aware retention list, and a cheaper extraction call. Only the map
# pass becomes unconditional — the reduce passes still trigger just while the text is
# over budget, so content that already fits costs one summarize call per page.
# AWE_ALWAYS_SUMMARIZE=false

# Output-token cap for the extraction call. Unset (0) sends no cap, leaving the
# endpoint's own limit in charge. Set it when the extract model is prone to
# degenerate generation: a JSON grammar allows arbitrary whitespace between tokens,
# so schema-guided decoding cannot break a repetition loop, and a model that falls
# into one emits blank indentation until something stops it. Uncapped that is the
# endpoint's limit, which can outlast the client read timeout — the call then looks
# like a timeout and is silently re-sent by the SDK's own retries, so one extraction
# burns many minutes with no recoverable error reaching the caller. A cap turns it
# into a prompt failure the caller can re-roll. Size it above the largest legitimate
# extraction for your schema; too low truncates good output.
# AWE_MAX_OUTPUT_TOKENS=0

# Fallback tiktoken encoding for token counting when the model name is unknown to
# tiktoken (routine for non-OpenAI models). Counts are then approximate, which is
# fine: they only drive the fit-or-summarize decision, not billing.
# AWE_TIKTOKEN_ENCODING=o200k_base

# ─────────────────────────────────────────────────────────────────────────────
# Caching
# ─────────────────────────────────────────────────────────────────────────────
# Content-addressed LLM-response cache (SQLite), on by default. When a page's
# normalized content is unchanged from a prior run, its screen verdict and link
# scores replay with zero LLM calls; per-chunk summaries and the consolidated
# extraction (when the exact same set of pages recurs) replay too. Keys mix in a
# version stamp over the criterion, schema, prompt templates, and models, so
# editing any of those misses instead of serving a stale result. Fetching is
# unaffected — this only skips model work. Empty = disable entirely.
# AWE_LLM_CACHE=data/llm_cache.sqlite

# ─────────────────────────────────────────────────────────────────────────────
# Logging
# ─────────────────────────────────────────────────────────────────────────────
# Append timestamped progress/diagnostic lines to this file. Empty/unset = off, a
# single knob. Lines always go to stderr regardless (stdout is reserved for the
# result JSON); a path just adds a durable record.
# AWE_LOG_FILE=awe.log
